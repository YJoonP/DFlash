+        with tempfile.TemporaryDirectory() as tmp:
+            for part in parts:
+                self._adb(["pull", part, tmp])
+            os.makedirs(os.path.dirname(local) or ".", exist_ok=True)
+            with open(local, "wb") as f:
+                for part in parts:
+                    with open(os.path.join(tmp, os.path.basename(part)), "rb") as g:
+                        shutil.copyfileobj(g, f)
+        self._adb(["shell", f"rm -f {prefix}*"])

+            ["shell", f"rm -f {prefix}* && split -b {chunk_mb}m -a 3 {remote} {prefix}"]
+        )
+        parts = sorted(
+            subprocess.run(
+                self._adb_prefix() + ["shell", f"ls {prefix}*"],
+                capture_output=True,
+                text=True,
+            ).stdout.split()
+        )

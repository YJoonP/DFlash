+    층에서 샤드를 시작하면 그 hidden 이 샤드 경계 텐서가 되어 런타임이 그래프 출력을 추가하지
+    않고도 읽을 수 있다 (QNN_Exporter 의 Qwen3-4B 2/8/8/8/8/2 분할과 같은 발상).
+    """
+    raw = os.environ.get("QNN_SHARD_LAYERS", "").strip()
+    if not raw:
+        return None
+    layers = sorted({int(x) for x in raw.split(",") if x.strip()})
+    if not layers or layers[0] <= 0:

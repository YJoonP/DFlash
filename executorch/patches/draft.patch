+def remap_ids_for_embed_vocab(sequences, vocab_size, n):
+    """QNN_EMBED_VOCAB 실험용 토큰 id 변환 (2026-09-14 KST).
+
+    model/static_llama.py 의 _embed_rows 와 같은 고정 시드 순열을 쓴다. 남긴 행의 원래 토큰 t 는
+    그 행 번호로 가고, 버린 토큰은 t % n 으로 보낸다. TPS 전용이라 의미 보존은 목표가 아니다.
+    """
+    import torch
+
+    rows = torch.randperm(vocab_size, generator=torch.Generator().manual_seed(0))[:n]
+    remap = torch.remainder(torch.arange(vocab_size), n)
+    remap[rows] = torch.arange(n)
+    return [remap[torch.as_tensor(seq, dtype=torch.long)].tolist() for seq in sequences]

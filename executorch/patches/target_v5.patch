+    def _pull_robust(self, remote, local):
+        """큰 파일은 조각으로 나눠 받는다.
+
+        이 USB 링크는 수백 MB 단일 전송에서 멈추지만(실측: 545MB logits pull 이 2% 에서
+        정체, 4회 재시도 전부 실패) 수십 MB 전송은 안정적이다. 조각마다 _adb 의 재시도가

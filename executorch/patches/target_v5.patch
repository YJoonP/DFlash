+def _env_shard_layers():
+    """QNN_SHARD_LAYERS="2,6,10,14,18,22,26,30" -> start a new shard at these layers instead of the even
+    split (fork_dflash 27016ac, ported 2026-10-01 KST). The DFlash draft reads the target's layer
+    [1,5,...,29] outputs; starting a shard right after those layers makes each one a shard-boundary tensor
+    the runtime can read without extra graph outputs."""
+    raw = os.environ.get("QNN_SHARD_LAYERS", "").strip()
+    if not raw:
+        return None
+    layers = sorted({int(x) for x in raw.split(",") if x.strip()})
+    if not layers or layers[0] <= 0:
+        raise ValueError(f"QNN_SHARD_LAYERS must list layer indices > 0: {raw!r}")
+    return layers

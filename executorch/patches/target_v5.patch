+  std::lock_guard<std::mutex> lk(MutBufMutex());
+  size_t count = 0;
+  for (auto& context : MutBufTable()) {
+    for (auto& entry : context.second) {
+      if (entry.second.ptr != nullptr) {
+        if (fill < 0) {
+          // 기본: 각 버퍼의 zero point 로 되돌린다 (= 실수 0).
+          MutBufFill(

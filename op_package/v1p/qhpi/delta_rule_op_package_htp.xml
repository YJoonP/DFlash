          <Layout>NHWC</Layout>
          <Text>B,T,H,dv</Text>
        </Shape>
      </Output>
      <Output>
        <Name>state_out</Name>
        <Description>
          <Content>(B,H,dk,dv) uint16 recurrent state</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>

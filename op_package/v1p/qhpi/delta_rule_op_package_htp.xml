    <OpDef>
      <Name>DeltaRuleState16Masked</Name>
      <Description>
        <Content>Fused gated delta-rule recurrence: S=S*decay; kv=S^T k; d=(v-kv)*beta; S+=k d^T; o=S^T q, unrolled over T inside the kernel with float32 state. Rows with valid == 0 leave the state unchanged and produce a zero output row (prompt padding).</Content>
      </Description>
      <Input>
        <Name>query</Name>
        <Description>
          <Content>(B,T,H,dk) l2-normed, scaled</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dk</Text>
        </Shape>
      </Input>
      <Input>
        <Name>key</Name>
        <Description>
          <Content>(B,T,H,dk) l2-normed</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dk</Text>
        </Shape>
      </Input>
      <Input>
        <Name>value</Name>
        <Description>
          <Content>(B,T,H,dv)</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dv</Text>

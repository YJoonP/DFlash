      <Input>
        <Name>beta</Name>
        <Description>
          <Content>(B,T,H,1) sigmoid gate</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,1</Text>
        </Shape>
      </Input>
      <Input>
        <Name>decay</Name>
        <Description>
          <Content>(B,T,H,1) exp(g) in (0,1)</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,1</Text>
        </Shape>
      </Input>
      <Input>
        <Name>state_in</Name>
        <Description>
          <Content>(B,H,dk,dv) uint16 recurrent state</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,H,dk,dv</Text>
        </Shape>
      </Input>
      <Input>
        <Name>valid</Name>
        <Description>

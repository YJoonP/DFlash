<?xml version='1.0' encoding='UTF-8'?>
<OpDefCollection PackageName="DeltaRuleOpPackage" Domain="aisw" Version="1.0">
  <OpDefList>
    <OpDef>
      <Name>DeltaRule</Name>
      <Description>
        <Content>Fused gated delta-rule recurrence: S=S*decay; kv=S^T k; d=(v-kv)*beta; S+=k d^T; o=S^T q, unrolled over T inside the kernel with float32 state.</Content>
      </Description>
      <Input>
        <Name>query</Name>
        <Description>
          <Content>(B,T,H,dk) l2-normed, scaled</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dk</Text>
        </Shape>
      </Input>
      <Input>
        <Name>key</Name>
        <Description>
          <Content>(B,T,H,dk) l2-normed</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dk</Text>
        </Shape>
      </Input>
      <Input>
        <Name>value</Name>
        <Description>
          <Content>(B,T,H,dv)</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dv</Text>
        </Shape>
      </Input>
      <Input>
        <Name>beta</Name>
        <Description>
          <Content>(B,T,H,1) sigmoid gate</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,1</Text>
        </Shape>
      </Input>
      <Input>
        <Name>decay</Name>
        <Description>
          <Content>(B,T,H,1) exp(g) in (0,1)</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,1</Text>
        </Shape>
      </Input>
      <Input>
        <Name>state_in</Name>
        <Description>
          <Content>(B,H,dk,dv) recurrent state, float32 only</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,H,dk,dv</Text>
        </Shape>
      </Input>
      <Output>
        <Name>out</Name>
        <Description>
          <Content>(B,T,H,dv)</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,T,H,dv</Text>
        </Shape>
      </Output>
      <Output>
        <Name>state_out</Name>
        <Description>
          <Content>(B,H,dk,dv) float32 only</Content>
        </Description>
        <Mandatory>true</Mandatory>
        <Datatype>QNN_DATATYPE_FLOAT_32</Datatype>
        <Shape>
          <Rank>4D</Rank>
          <Layout>NHWC</Layout>
          <Text>B,H,dk,dv</Text>
        </Shape>
      </Output>
      <SupportedBackend>HTP</SupportedBackend>
    </OpDef>

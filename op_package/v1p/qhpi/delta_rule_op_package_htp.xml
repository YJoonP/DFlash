    <OpDef>
      <Name>DeltaRuleDecode16</Name>
      <Description><Content>Decode-only fused delta recurrence. Q/K remain at unique-head count; value, gates, and state use value-head count. The kernel maps value head h to Q/K head h/repeat and emits no float workspace.</Content></Description>
      <Input><Name>query</Name><Description><Content>(B,1,Hq,dk) unique normalized query heads</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hq,dk</Text></Shape></Input>
      <Input><Name>key</Name><Description><Content>(B,1,Hq,dk) unique normalized key heads</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hq,dk</Text></Shape></Input>
      <Input><Name>value</Name><Description><Content>(B,1,Hv,dv) value heads</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hv,dv</Text></Shape></Input>
      <Input><Name>beta</Name><Description><Content>(B,1,Hv,1) gate</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hv,1</Text></Shape></Input>
      <Input><Name>decay</Name><Description><Content>(B,1,Hv,1) decay</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hv,1</Text></Shape></Input>
      <Input><Name>state_in</Name><Description><Content>(B,Hv,dk,dv) uint16 recurrent state</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,Hv,dk,dv</Text></Shape></Input>
      <Output><Name>out</Name><Description><Content>(B,1,Hv,dv)</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,1,Hv,dv</Text></Shape></Output>
      <Output><Name>state_out</Name><Description><Content>(B,Hv,dk,dv) uint16 recurrent state</Content></Description><Mandatory>true</Mandatory><Datatype>QNN_DATATYPE_UFIXED_POINT_16</Datatype><Shape><Rank>4D</Rank><Layout>NHWC</Layout><Text>B,Hv,dk,dv</Text></Shape></Output>
      <SupportedBackend>HTP</SupportedBackend>
    </OpDef>
